<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yomi.gui</string>

    <!-- 登录时打开 Yomi.app（GUI 内嵌 daemon 形态的开机自启）。
         用 open -a 而不是直拉二进制：GUI 程序要进 WindowServer 会话，
         launchd 直启没有图形上下文（旧 com.yomi.daemon.plist 登录卡死
         前科的反面教训）。已运行时 open -a 只是 focus，不重复起。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>Yomi</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
