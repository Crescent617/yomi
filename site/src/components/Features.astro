---
import Icon from './Icon.astro';

interface Feature {
  icons: string[];
  title: string;
  desc: string;
}

const features: Feature[] = [
  {
    icons: ['terminal'],
    title: 'Terminal-first, GUI when you want it',
    desc: 'A minimalist TUI, plus a Tauri desktop app with a usage panel and a desktop pet that mirrors agent mood.',
  },
  {
    icons: ['wrench'],
    title: 'Full toolbelt',
    desc: 'File read/write/edit, glob & grep, shell execution, web search — everything an agent needs, built in.',
  },
  {
    icons: ['plug'],
    title: 'Any provider',
    desc: 'OpenAI, Anthropic, or any OpenAI-compatible endpoint. Configurable context window and agent tools.',
  },
  {
    icons: ['shield'],
    title: 'Safe by default',
    desc: 'Read-only tool tiers, git-aware file walking, and confirmation for every mutation — unless you go YOLO.',
  },
  {
    icons: ['wifi'],
    title: 'Remote control',
    desc: 'Attach the GUI or CLI to a daemon running anywhere — YOMI_SOCKET speaks unix sockets and WebSockets, with optional password auth.',
  },
  {
    icons: ['bot'],
    title: 'IM bot',
    desc: 'Your agent joins Feishu and Telegram chats — threads map to sessions, approvals land in your pocket.',
  },
];
---

<section id="features" class="border-t border-line/70">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <p class="micro-label text-primary">Features</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight">
      Everything you need, nothing you don't
    </h2>
    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map(({ icons, title, desc }) => (
          <div>
            <div class="flex items-center gap-2.5 text-primary">
              {icons.map((icon) => (
                <Icon name={icon} class="h-5 w-5" />
              ))}
            </div>
            <h3 class="mt-3 font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
