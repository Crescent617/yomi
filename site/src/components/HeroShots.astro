---
import { Image } from 'astro:assets';
import guiWelcome from '../assets/gui-demo1.png';
import guiUsage from '../assets/gui-usage.png';
import guiAutomation from '../assets/gui-automation.png';
import guiTemplates from '../assets/gui-templates.png';
import guiThemes from '../assets/gui-themes.png';

const slides = [
  { img: guiWelcome, alt: 'Yomi GUI — welcome', label: 'Welcome' },
  { img: guiUsage, alt: 'Yomi GUI — usage stats', label: 'Usage' },
  { img: guiAutomation, alt: 'Yomi GUI — automation tasks', label: 'Automation' },
  { img: guiTemplates, alt: 'Yomi GUI — agent templates', label: 'Templates' },
  { img: guiThemes, alt: 'Yomi GUI — color themes', label: 'Themes' },
];
const step = 6; // seconds per slide
const cycle = slides.length * step;
const slideStyle = (i: number) =>
  `animation: crossfade ${cycle}s ease-in-out ${i * step}s infinite`;
---

<div class="shots relative mx-auto max-w-xl lg:max-w-none">
  <div
    class="absolute -inset-10 -z-10 rounded-full opacity-70 blur-3xl"
    style="background: radial-gradient(ellipse at 60% 40%, color-mix(in srgb, var(--primary) 17%, transparent), transparent 65%)"
  >
  </div>

  <figure class="shot shot-gui relative overflow-hidden rounded-xl border border-line shadow-2xl">
    {
      slides.map(({ img, alt }, i) => (
        <Image
          src={img}
          alt={alt}
          class:list={[
            'slide w-full',
            i === 0 ? 'relative' : 'absolute inset-0 h-full object-cover',
          ]}
          style={slideStyle(i)}
        />
      ))
    }
    <figcaption class="micro-label absolute right-3 top-3 z-10 rounded border border-line/70 bg-bg/70 px-2 py-1 text-muted backdrop-blur">
      GUI ·
      <span class="labels relative ml-1 inline-block w-20 overflow-hidden align-bottom">
        {
          slides.map(({ label }, i) => (
            <span class="label absolute left-0" style={slideStyle(i)}>
              {label}
            </span>
          ))
        }
      </span>
    </figcaption>
  </figure>
</div>

<style>
  /* GUI frame: layered crossfade carousel — opacity only, no motion */
  .slide:not(:first-child) {
    opacity: 0;
  }
  @keyframes crossfade {
    0% {
      opacity: 0;
    }
    4%,
    20% {
      opacity: 1;
    }
    24%,
    100% {
      opacity: 0;
    }
  }

  /* Caption labels cycle in sync */
  .labels {
    height: 1em;
    line-height: 1;
  }
  .label {
    opacity: 0;
    line-height: 1;
  }

  .shots:hover .slide,
  .shots:hover .label {
    animation-play-state: paused;
  }

  .shot {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shot-gui {
    transform: perspective(1400px) rotateY(-7deg) rotateX(2deg);
    animation:
      rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s backwards,
      float 8s ease-in-out 1.2s infinite;
  }
  .shots:hover .shot-gui {
    transform: perspective(1400px) rotateY(-2.5deg) rotateX(0.5deg);
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 28px;
    }
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot-gui {
      animation: none;
    }
    .slide:first-child {
      opacity: 1;
      animation: none;
    }
    .label:first-child {
      opacity: 1;
      animation: none;
    }
  }
</style>
